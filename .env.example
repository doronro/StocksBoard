# ============================================================================
# CRITICAL: SECURITY SETTINGS - CHANGE BEFORE PRODUCTION
# ============================================================================

# Application Settings
APP_NAME=Stock Exchange Board
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=development
LOG_LEVEL=INFO

# ============================================================================
# DATABASE CONFIGURATION - REQUIRED
# ============================================================================
# IMPORTANT: Use strong credentials in production!
# Database connection is built from individual environment variables for security
# Do NOT use the deprecated DATABASE_URL format with credentials embedded

# Database user (default: postgres)
DB_USER=postgres

# Database password - REQUIRED - CHANGE for production
# Generate strong password: python -c "import secrets; print(secrets.token_urlsafe(32))"
DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# Database host (default: localhost for local, postgres for docker-compose)
DB_HOST=localhost

# Database port (default: 5432)
DB_PORT=5432

# Database name (default: stock_exchange)
DB_NAME=stock_exchange

# Query logging (disable in production for performance)
DATABASE_ECHO=False

# ============================================================================
# AUTHENTICATION - CRITICAL FOR SECURITY
# ============================================================================
# CHANGE_ME: Generate a strong random secret key (minimum 32 characters)
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_WITH_STRONG_RANDOM_KEY_AT_LEAST_32_CHARS

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# REDIS CACHE CONFIGURATION
# ============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
CACHE_TTL_SECONDS=300

# ============================================================================
# API KEYS FOR MARKET DATA PROVIDERS
# ============================================================================
# Leave empty if not using, or add your provider API keys
# CHANGE_ME: Add real API keys if using market data providers
ALPHA_VANTAGE_API_KEY=
POLYGON_IO_API_KEY=
IEX_CLOUD_API_KEY=
YAHOO_FINANCE_API_KEY=

# ============================================================================
# CORS SETTINGS
# ============================================================================
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=Content-Type,Authorization

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ============================================================================
# WEBSOCKET SETTINGS
# ============================================================================
WEBSOCKET_HEARTBEAT_INTERVAL=30
WEBSOCKET_TIMEOUT=60

# ============================================================================
# EXTERNAL API SETTINGS
# ============================================================================
EXTERNAL_API_TIMEOUT=10
EXTERNAL_API_RETRIES=3

# ============================================================================
# MARKET DATA UPDATE FREQUENCY (seconds)
# ============================================================================
QUOTE_UPDATE_INTERVAL_SECONDS=5
TECHNICAL_INDICATOR_UPDATE_INTERVAL_SECONDS=300
PORTFOLIO_REVALUATION_INTERVAL_SECONDS=60

# ============================================================================
# DEPLOYMENT SETTINGS
# ============================================================================
API_PORT=8000
